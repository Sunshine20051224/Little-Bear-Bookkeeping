# Backend & Frontend connection settings
BACKEND_PORT=8001
FRONTEND_PORT=8501
BACKEND_URL=http://127.0.0.1:8001

# Database connection (SQLite for local dev/tests; provider DB URL in cloud)
DATABASE_URL=sqlite:///./expense_tracker.db
# API integration tests create an isolated database in pytest's temporary directory.

# Monthly budget defaults by category (example values)
DEFAULT_MONTHLY_BUDGET=1500.0
BUDGET_WARNING_RATIO=0.8
# Optional per-category override:
# BUDGET_FOOD=1500.0

# Optional legacy single read-only status check
DB_PROVIDER_STATUS_URL=

# 真实值仅保存在控制器主机上的 .env，勿提交或公开。
# 只读识别当前后端使用的数据库时，填写 Render 服务 ID 和 Render API 密钥。
RENDER_API_KEY=
RENDER_SERVICE_ID=
# 实际确认是 Render Postgres 后，才填 render-postgres 和获准的源实例与工作区。
MAINTENANCE_PROVIDER=
# Render Postgres 适配器兼容 DB_PROVIDER_API_KEY。仅诊断服务配置时使用上面的 RENDER_API_KEY。
DB_PROVIDER_API_KEY=
SOURCE_DB_ID=
RENDER_OWNER_ID=
# 以下数值仅示例。运行前按获准资源的真实套餐、区域、主版本和实例额度填写。
TARGET_DB_PLAN=free
TARGET_DB_REGION=frankfurt
TARGET_DB_VERSION=16
DB_INSTANCE_LIMIT=1
# 必须为有时区的 ISO 时间；缺省时只按服务商报告的维护或到期条件判断。
MAINTENANCE_AT_UTC=
CHECK_INTERVAL_SECONDS=60
MAINTENANCE_WAIT_SECONDS=0
# 默认在用户目录 .little-bear-maintenance 保存运行状态、最终备份和脱敏日志。
MAINTENANCE_STATE_DIR=
# 只有一个实例时，指向同主版本、全新、独立的本机 PostgreSQL 试恢复数据库。
TRIAL_DATABASE_URL=
# 可选的本机 PostgreSQL 测试库。仅供隔离测试，CI 另行配置。
MAINTENANCE_TEST_POSTGRES_URL=
